<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    TestNG suite configuration.

    parallel="classes"  : each test CLASS runs in its own thread.
                          Methods inside a class run sequentially — safe for our
                          one-browser-per-class design (ThreadLocal in DriverManager).
    thread-count="4"    : maximum 4 classes running at the same time.
-->
<suite name="JuiceShop Test Suite" parallel="classes" thread-count="4" verbose="1">

    <test name="All Tests">
        <classes>
            <class name="gradle.junit.selenium.tests.LoginTest"/>
            <class name="gradle.junit.selenium.tests.JuiceTest"/>
        </classes>
    </test>
</suite>
